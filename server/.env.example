PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
 
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/civimap
 
JWT_ACCESS_SECRET=replace_with_64_char_random_hex
JWT_REFRESH_SECRET=replace_with_a_different_64_char_random_hex
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_ISSUER=civimap-nepal
JWT_AUDIENCE=civimap-nepal-client
 
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_FROM="CiviMap Nepal <no-reply@civimap.np>"
 
COOKIE_DOMAIN=localhost
